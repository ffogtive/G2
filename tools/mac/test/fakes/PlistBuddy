#!/usr/bin/python3 -I
# 가짜 /usr/libexec/PlistBuddy -c 'Print :키' <plist> (바이너리·XML 모두 — 진짜 앱의 Info.plist 는 바이너리)
import plistlib, sys
a = sys.argv[1:]
if len(a) != 3 or a[0] != "-c" or not a[1].startswith("Print :"):
    sys.stderr.write("PlistBuddy(가짜): 지원하지 않는 호출 %r\n" % (a,))
    sys.exit(1)
key = a[1][len("Print :"):]
try:
    with open(a[2], "rb") as f:
        d = plistlib.load(f)
except FileNotFoundError:
    print("File Doesn't Exist, Will Create: %s" % a[2])
    sys.exit(1)
if key not in d:
    print('Print: Entry, ":%s", Does Not Exist' % key)
    sys.exit(1)
print(d[key])
