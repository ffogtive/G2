{
  "name": "g2-ddakji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PUFF! — blow-to-flip ddakji arcade game (mockup)",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch",
    "spike": "node tools/physics-spike.mjs",
    "app:www": "npm run build && node tools/app-www.mjs",
    "app:ios": "npm run app:www && npx cap sync ios",
    "app:open": "npx cap open ios",
    "app:run": "npm run app:ios && npx cap run ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@dimforge/rapier3d-compat": "0.12.0",
    "three": "0.162.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.24.0"
  }
}
